# Salin ke .env.local lalu isi.
# Lokal: nilai URL dan publishable key tampil setelah `npm run db:start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server saja. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini. Dev: tier gratis + data dummy saja. Pilot: tier berbayar.
GEMINI_API_KEY=

# Email. Dev: onboarding@resend.dev (hanya ke email akun Resend sendiri).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Web Push (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Google Sign-In untuk Supabase lokal (supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
